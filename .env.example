# ─── Required ────────────────────────────────────────────────
# PostgreSQL 14+. Local dev example:
#   DATABASE_URL=postgresql://postgres@127.0.0.1:5432/coe
DATABASE_URL=

# Keys session tokens and one-time email tokens. 32+ characters.
# Generate with:  openssl rand -hex 32
AUTH_SECRET=

# Public base URL — used to build links in emails.
APP_URL=http://localhost:3000

# ─── Email (optional in dev) ─────────────────────────────────
# Without SMTP_HOST + SMTP_USER, verification and reset links are printed to
# the server console instead of being sent. Fine locally; not fine in prod.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="COE Portal <no-reply@communityofemployees.com>"

# ─── Google Maps / Places ────────────────────────────────────
# Server-side key used by /api/places/*. Never sent to the browser.
GOOGLE_MAPS_API_KEY=

# Browser key used to render the map on /vendors. This one IS public, so
# restrict it by HTTP referrer in the Google Cloud console. Without it the
# directory still works as a distance-sorted list.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=

# ─── Scheduled maintenance (optional) ────────────────────────
# Lets a cron job call POST /api/maintenance with x-cron-secret.
CRON_SECRET=

# ─── Tuning (optional) ───────────────────────────────────────
# BCRYPT_ROUNDS=12
# DATABASE_POOL_MAX=10
# DATABASE_SSL=off        # only for a local server without TLS
